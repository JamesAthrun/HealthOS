# Local development only. Copy to .env; never commit real values.
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

POSTGRES_DB=healthos
POSTGRES_USER=healthos_app
POSTGRES_PASSWORD=replace-with-local-secret
DATABASE_URL=postgresql+psycopg://healthos_app:replace-with-local-secret@postgres:5432/healthos

# 会话签名密钥：python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-random-secret
PHOTO_DIR=/data/photos

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
