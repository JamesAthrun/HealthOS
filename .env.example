# Local development only. Copy to .env; never commit real values.
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

POSTGRES_DB=healthos
POSTGRES_USER=healthos_app
POSTGRES_PASSWORD=replace-with-local-secret
DATABASE_URL=postgresql+psycopg://healthos_app:replace-with-local-secret@postgres:5432/healthos

S3_ENDPOINT=http://minio:9000
S3_BUCKET=healthos-private
S3_ACCESS_KEY=replace-with-local-access-key
S3_SECRET_KEY=replace-with-local-secret-key
S3_REGION=local

OIDC_ISSUER=https://replace-with-issuer.example
OIDC_CLIENT_ID=replace-with-client-id
OIDC_CLIENT_SECRET=replace-with-client-secret

# Provider-specific keys are configured only when AI integration begins.
AI_PROVIDER=disabled
AI_API_KEY=
