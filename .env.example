# 复制为 .env 后填写；不要提交真实值。
# 本机直接运行的后端和部署时的 docker compose 都会读取这个文件。

# 本地开发不需要设置 DATABASE_URL：默认使用 backend/healthos_dev.sqlite3。
# 部署时 compose 会自动把 api 容器指向 PostgreSQL，只需要填下面三项。
POSTGRES_DB=healthos
POSTGRES_USER=healthos_app
POSTGRES_PASSWORD=replace-with-strong-secret

# 本地 http 开发为 false；上线 HTTPS 后改为 true
COOKIE_SECURE=false
# 允许发起写请求的来源（逗号分隔），上线后改为 https://<服务器IP>
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

PHOTO_DIR=/data/photos

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
