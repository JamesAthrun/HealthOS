# 本地开发：http://localhost:8080
# Sprint 5 上线时改为 https://<服务器IP> + tls internal（见 docs/DESIGN.md 第 7 节）
:80 {
    encode gzip

    handle /api/* {
        reverse_proxy api:8000
    }

    handle {
        root * /srv/web
        try_files {path} {path}/index.html /index.html
        file_server
    }
}
