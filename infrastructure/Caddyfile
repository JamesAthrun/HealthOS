# 本地开发：http://localhost:8080
# Sprint 5 上线时改为 https://<服务器IP> + tls internal（见 docs/DESIGN.md 第 7 节）
:80 {
    encode gzip
    # 访问日志（docker compose logs caddy）：排查请求有没有到达服务器
    log {
        output stdout
        format console
    }

    handle /api/* {
        reverse_proxy api:8000
    }

    # 带哈希的静态资源：长期缓存；找不到时返回 404，不能回退成 index.html（否则 CSS 会被当成 HTML，页面样式全丢）
    handle /_next/static/* {
        root * /srv/web
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # 页面每次都向服务器确认是否有新版本，避免手机缓存旧页面去引用已不存在的 CSS/JS
    handle {
        root * /srv/web
        header Cache-Control "no-cache"
        try_files {path} {path}/index.html /index.html
        file_server
    }
}
